DB_PASSWORD=change-me
ADMIN_PASSWORD=change-me-strong
REMINDER_INTERVAL_SECONDS=900

# ---- مرحله ۱۶: API یکپارچه
# RATE_LIMIT_PER_MIN=600          # درخواست در دقیقه برای هر توکن/کلید API/IP (0 = خاموش)
# RATE_LIMIT_LOGIN_PER_MIN=30     # تلاش ورود در دقیقه برای هر IP (0 = خاموش)
# TRUST_PROXY=0                   # 1 فقط پشت Nginx/Traefik مطمئن (برای خواندن X-Forwarded-For)
# CORS_ORIGINS=https://app.example.com,https://m.example.com   # خالی = فقط same-origin
# API_DOCS_ENABLED=1              # 0 = غیرفعال‌کردن /docs و /api/v1/openapi.json
# WEBHOOK_ALLOW_HTTP=0            # 1 فقط برای توسعه
# WEBHOOK_ALLOW_PRIVATE=0         # 1 فقط برای وبهوک به سرویس داخلی/توسعه (SSRF guard خاموش می‌شود)
# نشست: access کوتاه‌عمر + refresh چرخشی (کوکی HttpOnly)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
REFRESH_REUSE_GRACE_SECONDS=20
RATE_LIMIT_REFRESH_PER_MIN=120
