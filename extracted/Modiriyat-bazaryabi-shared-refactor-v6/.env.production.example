# کپی کنید به .env؛ رمزها را با  sh scripts/gen-secrets.sh  بسازید (مقدار نمونه نگذارید).
DOMAIN=erp.example.com
# DB_PASSWORD=
# ADMIN_PASSWORD=          # حداقل ۱۲ نویسه؛ مقدار placeholder باعث توقف راه‌اندازی می‌شود
# METRICS_TOKEN=           # خالی = /metrics خاموش
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=0
# CORS_ORIGINS=
# API_DOCS_ENABLED=0   # پیش‌فرض ۱ (راهنما/مستندات فعال)
